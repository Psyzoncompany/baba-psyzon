# Endpoint opcional de apoio à extração. O parser determinístico funciona sem estas variáveis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Necessários no servidor/migration quando não forem fornecidos pelo ambiente Google.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\service-account.json
BABA_ACCOUNT_UID=

# Servidor MCP do Baba (leia MCP.md antes de habilitar escrita).
BABA_MCP_WRITE_ENABLED=false
BABA_MCP_ACCESS_TOKEN=
BABA_MCP_CONFIRMATION_SECRET=
BABA_MCP_HOST=127.0.0.1
BABA_MCP_PORT=3001
BABA_MCP_ALLOWED_HOSTS=

# OAuth 2.1 do endpoint público /mcp (Gemini Spark e clientes remotos).
BABA_MCP_PUBLIC_URL=https://sitey-caixa.vercel.app
BABA_MCP_OAUTH_SECRET=
BABA_MCP_OAUTH_PASSWORD=

# Alternativa para hospedagens sem arquivo GOOGLE_APPLICATION_CREDENTIALS.
# Guarde o JSON completo como segredo do servidor; nunca envie ao navegador.
FIREBASE_SERVICE_ACCOUNT_JSON=
